[Unit]
Description=OpenCore MES public demo
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
User=opencore
Group=opencore
WorkingDirectory=/srv/opencore-mes/current
EnvironmentFile=/srv/opencore-mes/current/ops/demo/demo.env
EnvironmentFile=-/srv/opencore-mes/current/BUILD.env
# The copilot's provider and key, set on the server only (root:opencore, 0640), never in the repository.
EnvironmentFile=-/etc/opencore-mes/ai.env
ExecStart=/usr/local/bin/node app/mes/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/opencore-mes

[Install]
WantedBy=multi-user.target
