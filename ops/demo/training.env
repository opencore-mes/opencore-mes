# The training plant beside the trainings (plant.trainings.opencoremes.com, DESIGN.md §37): a second public
# demo from the same release, its own database, port, cookie and event log, reset every night. No secrets here.
PROD=1
DEMO=1
HOST=127.0.0.1
PORT=3001
INSTANCE=training
DATABASE_URL=postgres:///opencore_mes_training
PGHOST=/var/run/postgresql
PLANT_TZ=UTC
SESSION_COOKIE=mes_training_session
EVENT_LOG_DIR=/var/lib/opencore-mes/training-events
SCRIPT_RUNNER_WRAP=ops/script-runner-sandbox.sh
SCRIPT_ISOLATION=required
TRUST_PROXY=1
# The community edition alone: no suite is loaded (an empty folder), so a course teaches what is free.
SUITES_DIR=/var/lib/opencore-mes/training-suites
# The seed's own plant (lots, machines, work orders: what TRAINING.md's exercises use) and the guests.
SEED_GUEST=1
DEMO_AS=guest
DEMO_GUESTS=session
# A learner's own copy of Lot opens for them as soon as its change is executed: the guests take up the roles
# of each object a change makes live (the public demo's wait for the night's reset).
DEMO_GUESTS_FOLLOW=1
# A classroom often reaches it from one address: more guests per address than the demo allows.
DEMO_GUEST_LIMITS=60/600/3000
# The test sandbox (§5.13), served beside it on PORT + 1000 (4001), at an address of its own: the courses open it.
TEST_SANDBOX_URL=https://sandbox.trainings.opencoremes.com
# The trainings show it in a frame beside each course, and talk to it (docs/contracts/embedding).
EMBED_ORIGINS=https://trainings.opencoremes.com
AI_PROVIDER=
