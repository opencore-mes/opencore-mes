# demo.opencoremes.com: the server's settings (no secrets here: the copilot's key is on the server only, below).
PROD=1
DEMO=1
HOST=127.0.0.1
PORT=3000
INSTANCE=demo
DATABASE_URL=postgres:///openmes_demo
# The local socket: the openmes user signs in to PostgreSQL as itself, with no password.
PGHOST=/var/run/postgresql
PLANT_TZ=UTC
EVENT_LOG_DIR=/var/lib/open-mes/events
# The script runner under bubblewrap (provision.sh installs it): no network, nothing to read but the
# app's code (§12.4). The instance refuses to start without those walls; /healthz shows them (scripts).
SCRIPT_RUNNER_WRAP=ops/script-runner-sandbox.sh
SCRIPT_ISOLATION=required
# Caddy is the one proxy in front: a visitor's address is the one it wrote (a desktop's page, §6.8).
TRUST_PROXY=1
# Every reset: the seeded people, and the models of the suites shipped with the release (deploy.sh
# SUITES), their design packs and sample records; not the seed's own plant (lots, machines, work orders).
SEED_BLANK=1
SEED_SUITES=1
# A visitor arrives as the demo's guest, who holds every role (app/mes/db/guest.mjs), so a link from the
# landing page opens any screen, record or design; every reset makes it again.
SEED_GUEST=1
DEMO_AS=guest
# …each visitor a guest of their own ("Guest 7F3K"), within limits per address and per hour; past them,
# the shared one.
DEMO_GUESTS=session
# The copilot: AI_PROVIDER, AI_MODEL, AI_EFFORT and ANTHROPIC_API_KEY come from /etc/open-mes/ai.env on the
# server (open-mes.service), never from here; without that file, no copilot.
AI_PROVIDER=
