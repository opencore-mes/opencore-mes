# Copy to .env (never committed) and fill in; `npm run dev` reads it and restarts when it changes.
# Only what you set here matters; everything has a default (app/mes/server.mjs lists them all).

# The designer's copilot. Claude:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=        # only for a key not scoped to a workspace (Console → Workspaces)
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=high

# ...or any OpenAI-compatible model, in-house or another vendor's (vLLM, Ollama, ...):
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen3
# AI_API_KEY=

# PORT=9090
# HOST=0.0.0.0          every IPv4 address of this machine; :: for IPv6 too; 127.0.0.1 for this machine only
# DATABASE_URL=postgres:///openmes_poc

# The balancer (app/mes/lb.mjs) answers over HTTPS with a certificate, which tablets need to install
# the app and use its offline page: TLS_CERT=/path/cert.pem TLS_KEY=/path/key.pem LB_PORT=443 BACKENDS=127.0.0.1:9090
